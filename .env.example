DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,test.gigxmatch.com
DJANGO_TIME_ZONE=UTC

# Set DB_ENGINE=sqlite for a zero-config local run.
DB_ENGINE=mysql
DB_NAME=gymweb
DB_USER=root
DB_PASSWORD=
# Use 127.0.0.1 for native Windows/macOS/Linux. Use "db" only when the app
# runs in Docker Compose on the same network as a MySQL service named "db".
DB_HOST=127.0.0.1
DB_PORT=3306
